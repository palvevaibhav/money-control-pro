{
  "name": "money-control-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "build:mobile": "vite build",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npm run cap:sync && npx cap open android",
    "mobile:ios": "npm run cap:sync && npm run cap:open:ios",
    "mobile:android": "npm run cap:sync && npm run cap:open:android",
    "dev:full": "node scripts/full-dev.js",
    "build:apk": "scripts/build-apk.bat",
    "deploy": "./scripts/deploy.sh",
    "generate:skills": "node scripts/generate-skills.js",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mobile": "npm run cap:sync && npx cap run android --target emulator",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit && npx audit-ci --config audit-ci.json",
    "security:firebase": "firebase deploy --only firestore:rules",
    "performance:analyze": "npx vite-bundle-analyzer dist",
    "performance:test": "lighthouse http://localhost:5173 --output=json --output-path=./lighthouse-report.json",
    "performance:memory": "npx memlab run --scenario src/test/memory-test.js",
    "docs:generate": "typedoc --out docs src",
    "docs:api": "npx swagger-jsdoc -d swaggerDef.js -o docs/api.json src/**/*.ts",
    "docs:components": "npx storybook build -o docs/components",
    "docs:build": "npm run docs:generate && npm run docs:api && npm run docs:components",
    "db:migrate": "npx firestore-migrate",
    "db:migrate:create": "npx firestore-migrate create",
    "db:migrate:status": "npx firestore-migrate status",
    "db:migrate:up": "npx firestore-migrate up",
    "db:migrate:down": "npx firestore-migrate down",
    "ci:trigger": "gh workflow run deploy.yml",
    "ci:status": "gh run list --workflow=deploy.yml",
    "deploy:staging": "npm run build && npx vercel --prod=false",
    "deploy:production": "npm run build && npx vercel --prod=true",
    "deploy:rollback": "npx vercel rollback",
    "health:check": "curl -f http://localhost:5173/health || exit 1",
    "health:report": "npx lighthouse http://localhost:5173 --output=json | jq .categories",
    "monitor:performance": "npx web-vitals-reporter",
    "monitor:errors": "npx @sentry/cli releases propose-version",
    "a11y:audit": "npx axe-core-cli http://localhost:5173",
    "a11y:contrast": "npx @storybook/addon-a11y",
    "a11y:report": "npx lighthouse http://localhost:5173 --output=json --only-categories=accessibility",
    "i18n:extract": "npx i18next-scanner",
    "i18n:add": "npx i18next add",
    "i18n:update": "npx i18next update",
    "i18n:check": "npx i18next check",
    "i18n:build": "npx i18next build",
    "backup:create": "npx firestore-backup",
    "backup:restore": "npx firestore-restore",
    "backup:list": "npx firestore-backup list",
    "backup:export": "npx firestore-export",
    "backup:cleanup": "npx firestore-backup cleanup",
    "analytics:event": "npx analytics track",
    "analytics:dashboard": "npx analytics dashboard",
    "analytics:export": "npx analytics export",
    "analytics:privacy": "npx analytics privacy",
    "error:setup": "npx @sentry/wizard",
    "error:dashboard": "npx @sentry/cli releases list",
    "error:test": "npx @sentry/cli test",
    "error:report": "npx @sentry/cli releases finalize",
    "api:docs": "npx swagger-jsdoc -d swaggerDef.js -o docs/api.json",
    "api:test": "npx artillery run api-test.yml",
    "api:health": "curl -f https://api.moneycontrol.com/health || exit 1",
    "api:monitor": "npx artillery report",
    "review:check": "npm run lint && npm run type-check && npm run test:coverage",
    "review:create": "npx conventional-changelog",
    "review:analyze": "npx code-review-analyzer",
    "review:report": "npx review-report-generator",
    "deps:analyze": "npx depcheck && npx npm-check",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:audit": "npm audit",
    "deps:licenses": "npx license-checker",
    "deps:clean": "npx depcheck --json | jq -r '.dependencies[]' | xargs npm uninstall",
    "env:setup": "npx dotenv-vault setup",
    "env:validate": "npx dotenv-vault validate",
    "env:sync": "npx dotenv-vault sync",
    "env:backup": "npx dotenv-vault backup",
    "env:restore": "npx dotenv-vault restore",
    "env:health": "npx dotenv-vault health",
    "flag:create": "npx launchdarkly-cli flags create",
    "flag:rollout": "npx launchdarkly-cli flags update",
    "flag:target": "npx launchdarkly-cli flags update",
    "flag:experiment": "npx launchdarkly-cli experiments create",
    "flag:disable": "npx launchdarkly-cli flags off",
    "flag:status": "npx launchdarkly-cli flags list",
    "release:prepare": "npm version",
    "release:changelog": "npx conventional-changelog",
    "release:branch": "git checkout -b release/",
    "release:staging": "npm run deploy:staging",
    "release:production": "npm run deploy:production",
    "release:monitor": "npm run health:check",
    "release:rollback": "npm run deploy:rollback",
    "collab:setup": "npx slack-cli setup",
    "collab:board": "npx github-projects-cli create",
    "collab:meeting": "npx calendar-cli schedule",
    "collab:docs": "npx notion-cli create",
    "collab:progress": "npx github-projects-cli progress",
    "collab:report": "npx team-report-generator"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/browser": "^8.0.2",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "capacitor-biometric-authentication": "^2.2.0",
    "child_process": "^1.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "react-webcam": "^7.2.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
